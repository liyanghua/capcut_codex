{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:capcut:remix-reference-video:x-input-contract:change-request-script-candidate-select",
  "type": "object",
  "required": ["change_type", "scope_ids", "payload", "reason"],
  "properties": {
    "change_type": {"const": "script_candidate_select"},
    "scope_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "payload": {
      "type": "object",
      "required": ["script_candidate_id", "script_candidates_sha256"],
      "properties": {
        "script_candidate_id": {"type": "string", "minLength": 1},
        "script_candidates_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
