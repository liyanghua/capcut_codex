{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:capcut:remix-reference-video:artifact:process-assessment",
  "type": "object",
  "required": ["artifact_type", "schema_id", "schema_version", "contract_version", "skill_version", "run_id", "measurement_status", "approvals", "metrics"],
  "properties": {
    "artifact_type": {"const": "process_assessment"},
    "schema_id": {"const": "urn:capcut:remix-reference-video:artifact:process-assessment"},
    "schema_version": {"const": "1.0.0"},
    "contract_version": {"const": "2.0.0-alpha.1"},
    "skill_version": {"const": "2.0.0-alpha.1"},
    "run_id": {"type": "string", "minLength": 1},
    "measurement_status": {"enum": ["measured", "incomplete", "not_measured"]},
    "efficiency_measurement_status": {"enum": ["incomplete", "measured"]},
    "approvals": {"type": "object"},
    "current_approvals": {"type": "object"},
    "metrics": {"type": "object"},
    "evidence_paths": {"type": "array", "items": {"type": "string"}}
  }
}
