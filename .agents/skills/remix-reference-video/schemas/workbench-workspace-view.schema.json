{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:capcut:remix-reference-video:artifact:workbench-workspace-view",
  "title": "Business Workbench Workspace View",
  "type": "object",
  "required": ["artifact_type", "schema_id", "schema_version", "contract_version", "skill_version", "run_id", "state_revision", "current_gate", "lifecycle_status", "summary", "storyboard", "unclassified_assets", "preview", "timeline", "artifacts", "stage_artifacts", "artifact_versions", "lineage_edges", "evaluation_summary", "change_impact", "quality_checks", "process", "decision_context", "media_allowlist"],
  "properties": {
    "artifact_type": {"const": "workbench_workspace_view"},
    "schema_id": {"const": "urn:capcut:remix-reference-video:artifact:workbench-workspace-view"},
    "schema_version": {"const": "1.0.0"},
    "contract_version": {"const": "2.0.0-alpha.1"},
    "skill_version": {"const": "2.0.0-alpha.1"},
    "run_id": {"type": "string", "minLength": 1},
    "state_revision": {"type": "integer", "minimum": 0},
    "package_revision": {"type": ["integer", "string"]},
    "current_gate": {"enum": ["gate1", "gate2", "gate3_material_selection", "gate3_evidence_closure", "gate4_pre_generation", "gate4_post_generation", "gate5"]},
    "lifecycle_status": {"enum": ["ready", "not_ready", "stale"]},
    "summary": {"type": "object", "required": ["task", "product", "platform", "business_stage", "progress", "connection_ready"], "properties": {"task": {"type": "string"}, "product": {"type": "string"}, "platform": {"type": "string"}, "business_stage": {"type": "string"}, "progress": {"type": "number", "minimum": 0, "maximum": 1}, "connection_ready": {"type": "boolean"}}},
    "storyboard": {
      "type": "object",
      "required": ["elements", "shots", "audio", "section_states"],
      "properties": {
        "section_states": {
          "type": "object",
          "required": ["elements", "shots", "audio"],
          "properties": {
            "elements": {"enum": ["available", "empty", "pending_gate2"]},
            "shots": {"enum": ["available", "empty", "pending_gate2"]},
            "audio": {"enum": ["available", "empty", "pending_gate3"]}
          },
          "additionalProperties": false
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["element_id", "business_label", "purpose", "status", "media_type", "thumbnail_ref", "related_fragment_ids"],
            "properties": {
              "element_id": {"type": "string", "minLength": 1},
              "business_label": {"type": "string"},
              "purpose": {"type": "string"},
              "status": {"type": "string"},
              "media_type": {"type": ["string", "null"]},
              "thumbnail_ref": {"type": ["string", "null"]},
              "related_fragment_ids": {"type": "array", "items": {"type": "string"}},
              "related_shot_ids": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["shot_id", "order", "business_label", "purpose", "status", "media_type", "thumbnail_ref", "media_ref"],
            "properties": {
              "shot_id": {"type": "string", "minLength": 1},
              "order": {"type": "integer", "minimum": 1},
              "business_label": {"type": "string"},
              "purpose": {"type": "string"},
              "status": {"type": "string"},
              "media_type": {"type": ["string", "null"]},
              "thumbnail_ref": {"type": ["string", "null"]},
              "media_ref": {"type": ["string", "null"]},
              "reference_media_ref": {"type": ["string", "null"]},
              "start_seconds": {"type": ["number", "null"]},
              "end_seconds": {"type": ["number", "null"]},
              "claim_ids": {"type": "array", "items": {"type": "string"}},
              "fragment_id": {"type": "string"},
              "frame_available": {"type": "boolean"}
            }
          }
        },
        "audio": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["audio_id", "business_label", "purpose", "status", "media_type", "media_ref"],
            "properties": {
              "audio_id": {"type": "string", "minLength": 1},
              "business_label": {"type": "string"},
              "purpose": {"type": "string"},
              "status": {"type": "string"},
              "media_type": {"type": ["string", "null"]},
              "media_ref": {"type": ["string", "null"]},
              "measured_duration_seconds": {"type": ["number", "null"]},
              "fragment_id": {"type": "string"}
            }
          }
        }
      }
    },
    "unclassified_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "media_ref", "media_type", "reason", "replacement_eligible"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "media_ref": {"type": "string"},
          "media_type": {"type": ["string", "null"]},
          "reason": {"type": "string"},
          "replacement_eligible": {"type": "boolean"},
          "status": {"type": "string"}
        }
      }
    },
    "preview": {
      "type": "object",
      "required": ["mode", "media_ref", "status"],
      "properties": {
        "mode": {"enum": ["reference", "proxy", "final", "empty"]},
        "media_ref": {"type": ["string", "null"]},
        "status": {"enum": ["ready", "not_ready"]},
        "empty_reason": {"type": "string"}
      }
    },
    "timeline": {
      "type": "object",
      "required": ["source", "total_duration_seconds", "tracks"],
      "properties": {
        "source": {"type": "string"},
        "timebase": {"enum": ["source_range", "output"]},
        "total_duration_seconds": {"type": ["number", "null"]},
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["track_id", "kind", "segments"],
            "properties": {
              "track_id": {"type": "string", "minLength": 1},
              "kind": {"type": "string"},
              "segments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["segment_id", "label", "start_seconds", "end_seconds", "duration_seconds", "related_object_id", "thumbnail_ref"],
                  "properties": {
                    "segment_id": {"type": "string", "minLength": 1},
                    "label": {"type": "string"},
                    "start_seconds": {"type": ["number", "null"]},
                    "end_seconds": {"type": ["number", "null"]},
                    "duration_seconds": {"type": ["number", "null"]},
                    "related_object_id": {"type": "string"},
                    "thumbnail_ref": {"type": ["string", "null"]}
                  }
                }
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "business_label", "business_stage", "status", "media_ref", "relations", "diagnostics"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "business_label": {"type": "string"},
          "business_stage": {"type": "string"},
          "status": {"enum": ["available", "pending"]},
          "media_ref": {"type": ["string", "null"]},
          "relations": {"type": "object"},
          "diagnostics": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "stage_artifacts": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "required": ["stage_id", "business_label", "artifacts"],
        "properties": {
          "stage_id": {"type": "string"}, "business_label": {"type": "string"},
          "artifacts": {"type": "array", "items": {"type": "object", "required": ["artifact_id", "business_label", "status", "summary", "thumbnail_ref", "preview_ref"], "properties": {"artifact_id": {"type": "string"}, "business_label": {"type": "string"}, "status": {"enum": ["available", "not_generated_legacy"]}, "summary": {"type": "string"}, "thumbnail_ref": {"type": ["string", "null"]}, "preview_ref": {"type": ["string", "null"]}}, "additionalProperties": false}}
        }, "additionalProperties": false
      }
    },
    "artifact_versions": {
      "type": "array", "items": {"type": "object", "required": ["artifact_id", "candidate_versions"], "properties": {"artifact_id": {"type": "string"}, "candidate_versions": {"type": "array", "items": {"type": "object", "required": ["version_id", "strategy_id", "summary", "diff_summary", "status", "selected"], "properties": {"version_id": {"type": "string"}, "strategy_id": {"type": ["string", "null"]}, "summary": {"type": "string"}, "diff_summary": {"type": "string"}, "status": {"type": "string"}, "selected": {"type": "boolean"}}, "additionalProperties": false}}}, "additionalProperties": false}
    },
    "lineage_edges": {
      "type": "array", "items": {"type": "object", "required": ["from_artifact_id", "to_artifact_id", "business_label"], "properties": {"from_artifact_id": {"type": "string"}, "to_artifact_id": {"type": "string"}, "business_label": {"type": "string"}}, "additionalProperties": false}
    },
    "evaluation_summary": {
      "type": "object", "required": ["stages"], "properties": {"stages": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "required": ["business_label", "north_star", "constraint_metrics", "evidence_source", "measurement_status", "not_measured_reason"], "properties": {"business_label": {"type": "string"}, "north_star": {"type": "string"}, "constraint_metrics": {"type": "string"}, "evidence_source": {"type": ["string", "null"]}, "measurement_status": {"const": "not_measured"}, "not_measured_reason": {"type": "string"}}, "additionalProperties": false}}}, "additionalProperties": false
    },
    "change_impact": {
      "type": "array", "items": {"type": "object", "required": ["change_type", "earliest_affected_gate", "stale_artifacts", "requires_tts", "requires_render", "business_explanation"], "properties": {"change_type": {"type": "string"}, "earliest_affected_gate": {"type": ["string", "null"]}, "stale_artifacts": {"type": "array", "items": {"type": "string"}}, "requires_tts": {"type": "boolean"}, "requires_render": {"type": "boolean"}, "business_explanation": {"type": "string"}}, "additionalProperties": false}
    },
    "quality_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "business_label", "status", "source_artifact", "detail", "gate_scope"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "business_label": {"type": "string"},
          "status": {"type": "string"},
          "source_artifact": {"type": ["string", "null"]},
          "detail": {"type": "object"},
          "gate_scope": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "process": {
      "type": "object",
      "required": ["current_stage", "stages", "execution"],
      "properties": {
        "current_stage": {"type": "string"},
        "current_gate": {"type": "string"},
        "stages": {"type": "array", "minItems": 5, "maxItems": 5},
        "execution": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stage_id", "business_label", "status"],
            "properties": {
              "stage_id": {"type": "string", "minLength": 1},
              "business_label": {"type": "string"},
              "status": {"type": "string"},
              "attempt_id": {"type": ["string", "null"]},
              "wall_seconds": {"type": ["number", "null"]},
              "cache_status": {"type": ["string", "null"]},
              "recorded_at": {"type": ["string", "null"]},
              "failure_reason": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "decision_context": {"type": "object", "required": ["question", "recommendation", "evidence", "risks", "next_action", "approval_eligibility"], "properties": {"question": {"type": "string"}, "recommendation": {"type": "string"}, "evidence": {"type": "array"}, "risks": {"type": "array"}, "next_action": {"type": "string"}, "approval_eligibility": {"type": "boolean"}}},
    "media_allowlist": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": true
}
