{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:capcut:remix-reference-video:artifact:script-candidates",
  "title": "Production Script Candidates",
  "type": "object",
  "required": ["artifact_type", "schema_id", "schema_version", "contract_version", "skill_version", "implementation_version", "lifecycle_status", "input_hashes", "candidates"],
  "properties": {
    "artifact_type": {"const": "script_candidates"},
    "schema_id": {"const": "urn:capcut:remix-reference-video:artifact:script-candidates"},
    "schema_version": {"const": "1.0.0"},
    "contract_version": {"const": "2.0.0-alpha.1"},
    "skill_version": {"const": "2.0.0-alpha.1"},
    "implementation_version": {"type": "string", "minLength": 1},
    "lifecycle_status": {"enum": ["ready", "stale"]},
    "input_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "objective_id": {"type": "string"},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "prompt_template_version": {"type": "string"},
    "seed": {"type": ["integer", "null"]},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "required": ["script_candidate_id", "status"], "properties": {"script_candidate_id": {"type": "string", "minLength": 1}, "status": {"type": "string"}, "creative_hypothesis": {"type": "string"}, "objective_coverage": {"type": "array", "items": {"type": "string"}}, "lines": {"type": "array", "items": {"$ref": "#/$defs/line"}}, "risk_notes": {"type": "array", "items": {"type": "string"}}, "uncovered_objectives": {"type": "array", "items": {"type": "string"}}, "provider": {"type": "string"}, "model": {"type": "string"}, "prompt_template_version": {"type": "string"}, "seed": {"type": "integer"}, "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}, "additionalProperties": false}}
  },
  "$defs": {
    "line": {"type": "object", "required": ["script_line_id", "fragment_id", "text", "evidence_row_ref", "visual_intent", "estimated_duration_seconds"], "properties": {"script_line_id": {"type": "string", "minLength": 1}, "fragment_id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "objective_id": {"type": ["string", "null"]}, "narrative_role": {"type": "string"}, "required_actions": {"type": "array", "items": {"type": "string"}}, "claim_ids": {"type": "array", "items": {"type": "string"}}, "evidence_row_ref": {"type": "string", "minLength": 1}, "visual_intent": {"type": "object", "additionalProperties": true}, "visual_duration_budget_seconds": {"type": ["number", "null"], "minimum": 0}, "continuity_before": {"type": ["string", "null"]}, "continuity_after": {"type": ["string", "null"]}, "estimated_duration_seconds": {"type": "number", "minimum": 0}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
