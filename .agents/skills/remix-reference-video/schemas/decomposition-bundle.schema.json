{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:capcut:remix-reference-video:artifact:decomposition-bundle",
  "title": "Creative Decomposition Bundle",
  "type": "object",
  "required": ["artifact_type", "schema_id", "schema_version", "contract_version", "skill_version", "implementation_version", "lifecycle_status", "input_hashes", "candidates"],
  "properties": {
    "artifact_type": {"const": "decomposition_bundle"},
    "schema_id": {"const": "urn:capcut:remix-reference-video:artifact:decomposition-bundle"},
    "schema_version": {"const": "1.0.0"},
    "contract_version": {"const": "2.0.0-alpha.1"},
    "skill_version": {"const": "2.0.0-alpha.1"},
    "implementation_version": {"type": "string", "minLength": 1},
    "lifecycle_status": {"enum": ["ready", "stale"]},
    "input_hashes": {"$ref": "#/$defs/input_hashes"},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/candidate"}},
    "bundle_version": {"type": "string", "minLength": 1},
    "recipe_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "differences": {"type": "array", "items": {"type": "object", "required": ["candidate_a", "candidate_b", "summary"], "properties": {"candidate_a": {"type": "string"}, "candidate_b": {"type": "string"}, "summary": {"type": "string"}}, "additionalProperties": false}}
  },
  "$defs": {
    "input_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "candidate": {
      "type": "object",
      "required": ["decomposition_id", "strategy_id"],
      "properties": {
        "decomposition_id": {"type": "string", "minLength": 1},
        "strategy_id": {"enum": ["structure_semantic_v1", "rhythm_visual_v1", "evidence_action_v1", "hybrid_commerce_v1"]},
        "implementation_version": {"type": "string", "minLength": 1},
        "recipe_shot_ids": {"type": "array", "items": {"type": "string"}},
        "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
        "hook_interval": {"$ref": "#/$defs/interval"},
        "rhythm_peaks": {"type": "array", "items": {"$ref": "#/$defs/interval"}},
        "highlight_candidates": {"type": "array", "items": {"type": "string"}},
        "uncertain_cuts": {"type": "array", "items": {"type": "string"}},
        "manual_revisions": {"type": "array", "items": {"type": "string"}},
        "explanation": {"type": "string"}
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": ["segment_id"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1},
        "recipe_shot_ids": {"type": "array", "items": {"type": "string"}},
        "narrative_function": {"type": "string"},
        "actions": {"type": "array", "items": {"type": "string"}},
        "product_visibility": {"type": "string"},
        "evidence_role": {"type": "string"},
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "interval": {"type": "object", "required": ["start_seconds", "end_seconds"], "properties": {"start_seconds": {"type": "number", "minimum": 0}, "end_seconds": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
